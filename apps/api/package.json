{
  "name": "@acarvo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:migrate:test": "tsx --env-file=../../.env src/db/migrate.ts --test",
    "db:seed": "tsx --env-file=../../.env seed/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@acarvo/shared": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
