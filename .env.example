# Copy is created automatically by scripts/setup-db.ps1 as .env (never committed).
# Values below are placeholders only.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Runtime role: acarvo_app (no superuser, no BYPASSRLS, not table owner)
DATABASE_URL=postgres://acarvo_app:<password>@localhost:5432/acarvo
# Migrations and seed: acarvo_owner
DATABASE_OWNER_URL=postgres://acarvo_owner:<password>@localhost:5432/acarvo
TEST_DATABASE_URL=postgres://acarvo_app:<password>@localhost:5432/acarvo_test
TEST_DATABASE_OWNER_URL=postgres://acarvo_owner:<password>@localhost:5432/acarvo_test
COOKIE_SECRET=<at least 32 random characters>
